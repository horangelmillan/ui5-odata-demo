<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog id="invoiceCreateDialog" title="{i18n>invoice.create.title}" contentWidth="500px" afterClose=".onCreateInvoiceDialogClosed">
        <content>
            <VBox id="createInvoiceMessageStripBox" visible="false" />
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false">
                <f:content>
                    <Label text="{i18n>invoice.create.field.id}" />
                    <Input id="createInvoiceId" placeholder="INV-001" />

                    <Label text="{i18n>invoice.create.field.cliente}" />
                    <ComboBox id="createInvoiceCustomer" items="{/customer-odata}" required="true">
                        <core:Item key="{id}" text="{nombre}" />
                    </ComboBox>

                    <Label text="{i18n>invoice.create.field.sociedad}" />
                    <ComboBox id="createInvoiceCompany" items="{/company-odata}" required="true">
                        <core:Item key="{id}" text="{nombre}" />
                    </ComboBox>

                    <Label text="{i18n>invoice.create.field.importe}" />
                    <Input id="createInvoiceImporte" type="Number" step="0.01" placeholder="0.00" required="true" />

                    <Label text="{i18n>invoice.create.field.moneda}" />
                    <ComboBox id="createInvoiceMoneda" required="true">
                        <core:Item key="EUR" text="EUR" />
                        <core:Item key="USD" text="USD" />
                    </ComboBox>

                    <Label text="{i18n>invoice.create.field.fecha}" />
                    <DatePicker id="createInvoiceFecha" required="true" displayFormat="yyyy-MM-dd" />
                </f:content>
            </f:SimpleForm>
        </content>
        <buttons>
            <Button text="{i18n>button.save}" press=".onCreateInvoiceSave" type="Emphasized" />
            <Button text="{i18n>button.cancel}" press=".onCreateInvoiceCancel" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>