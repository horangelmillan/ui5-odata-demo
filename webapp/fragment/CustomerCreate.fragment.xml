<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog id="customerCreateDialog" title="{i18n>customer.create.title}" contentWidth="400px" afterClose=".onCreateCustomerDialogClosed">
        <content>
            <VBox id="createCustomerMessageStripBox" visible="false" />
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false">
                <f:content>
                    <Label text="{i18n>customer.create.field.id}" />
                    <Input id="createCustomerId" placeholder="CUST-001" />

                    <Label text="{i18n>customer.create.field.nombre}" />
                    <Input id="createCustomerNombre" required="true" />

                    <Label text="{i18n>customer.create.field.pais}" />
                    <Input id="createCustomerPais" required="true" />
                </f:content>
            </f:SimpleForm>
        </content>
        <buttons>
            <Button text="{i18n>button.save}" press=".onCreateCustomerSave" type="Emphasized" />
            <Button text="{i18n>button.cancel}" press=".onCreateCustomerCancel" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>