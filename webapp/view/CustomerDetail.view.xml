<mvc:View
    controllerName="ui5.odata.demo.controller.CustomerDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <!-- ui5lint-disable no-globals -->


    <Page title="{i18n>page.customerDetail.title}" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <f:Form editable="false">
                <f:title><core:Title text="{i18n>customerDetail.form.title}"/></f:title>
                <f:layout><f:ResponsiveGridLayout/></f:layout>
                <f:formContainers>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement label="{i18n>customerDetail.field.id}">
                                <f:fields><Text text="{id}"/></f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>customerDetail.field.nombre}">
                                <f:fields><Text text="{nombre}"/></f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>customerDetail.field.pais}">
                                <f:fields><Text text="{pais}"/></f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                </f:formContainers>
            </f:Form>

            <Panel headerText="{i18n>customerDetail.invoices.panel.title}">
                <Table items="{invoices}">
                    <columns>
                        <Column><Label text="{i18n>customerDetail.invoices.column.id}"/></Column>
                        <Column><Label text="{i18n>customerDetail.invoices.column.importe}"/></Column>
                        <Column><Label text="{i18n>customerDetail.invoices.column.estado}"/></Column>
                        <Column><Label text="{i18n>customerDetail.invoices.column.fecha}"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{id}"/>
                                <ObjectNumber number="{importe}" unit="{moneda}"/>
                                <Text text="{estado}"/>
                                <Text text="{path: 'fecha', type: 'sap.ui.model.type.String'}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
        </content>
    </Page>
</mvc:View>
