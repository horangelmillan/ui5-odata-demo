<mvc:View
    controllerName="ui5.odata.demo.controller.PaymentList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table">

    <Page title="{i18n>page.paymentList.title}">
        <content>
            <OverflowToolbar id="filterToolbar">
                <Label text="{i18n>payment.filter.metodo}"/>
                <ComboBox id="filterMetodo" placeholder="{i18n>payment.filter.all}">
                    <core:Item key="" text="{i18n>payment.filter.all}"/>
                    <core:Item key="TRANSFER" text="TRANSFER"/>
                    <core:Item key="CARD" text="CARD"/>
                    <core:Item key="CHECK" text="CHECK"/>
                </ComboBox>
                <Button text="{i18n>payment.filter.apply}" press=".onFilter"/>
                <Button text="{i18n>payment.filter.clear}" press=".onClearFilter"/>
            </OverflowToolbar>
            <table:Table id="tblPayments"
                rows="{path: '/payment-odata', parameters: { $expand: 'invoice' }}"
                threshold="10"
                enableBusyIndicator="true"
                selectionMode="Single"
                selectionBehavior="Row"
                rowSelectionChange=".onPaymentSelect">
                <table:columns>
                    <table:Column>
                        <Label text="{i18n>payment.column.id}"/>
                        <table:template><Text text="{id}"/></table:template>
                    </table:Column>
                    <table:Column>
                        <Label text="{i18n>payment.column.factura}"/>
                        <table:template><Text text="{invoice/id}"/></table:template>
                    </table:Column>
                    <table:Column>
                        <Label text="{i18n>payment.column.importe}"/>
                        <table:template><ObjectNumber number="{importe}"/></table:template>
                    </table:Column>
                    <table:Column>
                        <Label text="{i18n>payment.column.metodo}"/>
                        <table:template><Text text="{metodo}"/></table:template>
                    </table:Column>
                    <table:Column>
                        <Label text="{i18n>payment.column.fecha}"/>
                        <table:template><Text text="{path: 'fecha', type: 'sap.ui.model.type.String'}"/></table:template>
                    </table:Column>
                </table:columns>
            </table:Table>
        </content>
    </Page>
</mvc:View>
