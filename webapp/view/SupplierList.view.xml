<mvc:View
    controllerName="ui5.odata.demo.controller.SupplierList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table">
    <Page title="{i18n>page.supplierList.title}">
        <content>
            <table:Table id="tblSuppliers"
                rows="{/supplier-odata}"
                threshold="10"
                enableBusyIndicator="true"
                selectionMode="Single"
                selectionBehavior="Row">
                <table:columns>
                    <table:Column><Label text="{i18n>supplier.column.id}"/><table:template><Text text="{id}"/></table:template></table:Column>
                    <table:Column><Label text="{i18n>supplier.column.nombre}"/><table:template><Text text="{nombre}"/></table:template></table:Column>
                    <table:Column><Label text="{i18n>supplier.column.pais}"/><table:template><Text text="{pais}"/></table:template></table:Column>
                </table:columns>
            </table:Table>
        </content>
    </Page>
</mvc:View>
